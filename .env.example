GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional Groq tuning (defaults shown)
# GROQ_MAX_RETRIES=3     retries after an HTTP 429, with Retry-After or exponential backoff plus jitter
# GROQ_MAX_WAIT_S=60     a single wait longer than this (e.g. a daily limit) fails at once instead of sleeping
# GROQ_MAX_STEPS=6       model round trips allowed per customer message
